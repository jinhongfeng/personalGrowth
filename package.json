{
  "name": "personal-growth-app",
  "version": "1.0.0",
  "description": "个人成长与活人感恢复助手",
  "main": "dist-electron/main.js",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "electron:dev": "vite",
    "electron:build": "vite build && electron-builder",
    "android:add": "cap add android",
    "android:sync": "vite build && cap sync android",
    "android:build": "vite build && cap sync android && cd android && gradlew.bat assembleDebug"
  },
  "build": {
    "appId": "com.personal.growth",
    "productName": "PersonalGrowth",
    "asar": true,
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "dist-electron/**/*",
      "package.json"
    ],
    "win": {
      "icon": "public/app-icon.ico",
      "signAndEditExecutable": false,
      "target": [
        {
          "target": "dir",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "electronDist": "node_modules/electron/dist",
    "electronVersion": "28.3.3"
  },
  "dependencies": {
    "@capacitor/android": "^8.4.0",
    "@capacitor/app": "^8.1.0",
    "@capacitor/core": "^8.4.0",
    "@quasar/extras": "^1.16.0",
    "@quasar/vite-plugin": "^1.12.0",
    "crypto-js": "^4.2.0",
    "pinia": "^2.1.0",
    "quasar": "^2.14.0",
    "vue": "^3.4.0",
    "vue-router": "^4.2.0"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.4.0",
    "@types/crypto-js": "^4.2.0",
    "@vitejs/plugin-vue": "^5.0.0",
    "electron": "^28.0.0",
    "electron-builder": "^24.9.0",
    "sass": "^1.100.0",
    "typescript": "^5.3.0",
    "vite": "^5.0.0",
    "vite-plugin-electron": "^0.28.0",
    "vite-plugin-electron-renderer": "^0.14.0",
    "vue-tsc": "^1.8.0"
  }
}
